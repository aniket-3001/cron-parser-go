{
  "name": "cron-parser-go-adapter",
  "version": "0.0.0",
  "private": true,
  "description": "Test adapter that runs the original cron-parser suite against the Go port.",
  "scripts": {
    "build": "node scripts/build.js",
    "test": "npm run build && cross-env TZ=UTC jest",
    "test:original": "cross-env TZ=UTC jest",
    "test:go": "go test ./cron/... -count=1",
    "verify-hashes": "node scripts/verify-hashes.js",
    "fuzz": "node fuzz/differential.js --seconds=60",
    "bench": "node bench/report.js",
    "compare": "node compare/cli-diff.js",
    "honest-numbers": "node scripts/honest-numbers.js",
    "build:web": "node scripts/build-web.js",
    "web": "npm run build:web && npx --yes serve web",
    "verify:web": "node scripts/verify-web.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@jest/globals": "^30.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "cross-env": "^7.0.3",
    "jest": "^30.0.0",
    "luxon": "^3.7.2",
    "@types/luxon": "^3.6.2",
    "sinon": "^22.0.0",
    "ts-jest": "^29.4.0",
    "typescript": "^5.6.0",
    "puppeteer-core": "^24.0.0",
    "esbuild": "^0.24.0"
  }
}
