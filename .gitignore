node_modules/
dist/
coverage/
*.wasm
adapter/wasm_exec.js
scripts/probe/node_modules/

# Differential corpora are regenerated on demand and run to tens of megabytes.
scripts/probe/*-corpus.json
adapter/wasm-bytes.js

# The fuzz log and the CLI diff are published evidence, so they are tracked.
# Only the regenerable corpora are ignored.

# Live fuzzer output. Reproductions here come from whatever the last run did,
# including the deliberate sabotage runs used to validate the harness, so they
# are not evidence of anything on their own. fuzz/log.txt and fuzz/last-run.json
# record the clean run instead. See fuzz/README.md.
fuzz/divergences/

# Built artifacts. Anchored with a leading slash: an unanchored "cron-parser"
# also matches the cmd/cron-parser/ source directory.
/cron-parser
/cron-parser.exe
/bench-port
/bench-port.exe

# Coverage profiles. npm run honest-numbers writes one per run and removes it,
# but an interrupted run leaves it behind.
*.out

# Playground build output. Both implementations are compiled by npm run
# build:web, and committing either would let the deployed page compare
# something other than what this repository contains.
web/cron.wasm
web/original.js
web/wasm_exec.js
web/smoke.html
